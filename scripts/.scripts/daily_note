#!/usr/bin/env bash

folder="$HOME/Vaults/personal/journal/"
sock="/tmp/nvim_daily.sock"
terminal=kitty


focus_or_spawn_editor() {
    local windows
    windows="$(niri msg --json windows)"
    local window_id
    window_id="$(
        jq -r ' .[]
            | select(.title == "daily-note")
            | .id
        ' <<< "$windows" |
        head -n 1
    )"

    if [[ -n "$window_id" ]]; then
        niri msg action focus-window --id "$window_id"
    else
        niri msg action spawn-sh \
            -- "$terminal --title 'daily-note' -e nvim --listen '$sock' '$folder'"
        while [[ ! -S "$sock" ]]; do
            sleep 0.01
        done

        nvim --server "$sock" --remote-send ':Obsidian today<CR>'
    fi
}

toggle_editor() {
    local focused
    focused="$(niri msg --json focused-window)"
    local title
    title="$(jq -r '.title // ""' <<< "$focused")"
    local window_id
    window_id="$(jq -r '.id' <<< "$focused")"

    if [[ "$title" == "daily-note" ]]; then
        # Save and quit Neovim.
        if [[ -S "$sock" ]]; then
            nvim --server "$sock" --remote-send ':wqa<CR>'
        fi
    else
        focus_or_spawn_editor
    fi
}

toggle_editor
